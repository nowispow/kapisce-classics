# ---------------------------------------------------------------------------
# Kapisce Classics — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Phase 1 — Analytics (PostHog self-hosted)
# ---------------------------------------------------------------------------
# Base URL of your PostHog instance, e.g. https://analytics.kapisce.com
POSTHOG_HOST=

# Project API key from PostHog Settings → Project → API Key
POSTHOG_KEY=

# ---------------------------------------------------------------------------
# Phase 1 — Email / Lead Capture (Listmonk)
# ---------------------------------------------------------------------------
# Base URL of your Listmonk instance, e.g. https://mail.kapisce.com
LISTMONK_URL=

# Listmonk API credentials (Settings → Users → API credentials)
LISTMONK_USERNAME=
LISTMONK_API_KEY=

# ---------------------------------------------------------------------------
# Phase 1 — SMTP Relay (Resend)
# ---------------------------------------------------------------------------
# Resend API key — used as the SMTP password in Listmonk's SMTP config
# Dashboard → API Keys → Create API Key
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Phase 1 — Forms & Webhooks (Fastify API)
# ---------------------------------------------------------------------------
# Public base URL of the deployed Fastify service, e.g. https://api.kapisce.com
API_BASE_URL=

# ---------------------------------------------------------------------------
# Phase 2 — Payments (Lemon Squeezy)
# ---------------------------------------------------------------------------
# API key from Lemon Squeezy → Settings → API
LEMONSQUEEZY_API_KEY=

# Signing secret for validating incoming Lemon Squeezy webhook payloads
LEMONSQUEEZY_WEBHOOK_SECRET=

# Store slug, e.g. kapisce
LEMONSQUEEZY_STORE_SLUG=
