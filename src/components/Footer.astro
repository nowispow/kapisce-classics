---
import { SOCIAL_LINKS } from '@/consts'
import SocialIcons from './SocialIcons.astro'
---

<footer
  class="mx-auto mb-8 flex w-full max-w-3xl flex-col items-center justify-center gap-y-2 px-4 sm:mb-4"
>
  <div class="flex flex-wrap items-center justify-center gap-x-4 text-center">
    <span class="text-muted-foreground text-sm">
      &copy; {new Date().getFullYear()} Nowispow, Inc
    </span>
    <nav class="flex flex-wrap items-center justify-center gap-x-3 text-sm">
      <a href="/terms" class="text-muted-foreground hover:text-foreground transition-colors">Terms</a>
      <a href="/privacy" class="text-muted-foreground hover:text-foreground transition-colors">Privacy</a>
      <a href="/eula" class="text-muted-foreground hover:text-foreground transition-colors">EULA</a>
      <a href="/dpa" class="text-muted-foreground hover:text-foreground transition-colors">DPA</a>
    </nav>
  </div>
  <SocialIcons links={SOCIAL_LINKS} />
</footer>
