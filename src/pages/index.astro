---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getRecentPosts } from '@/lib/data-utils'

const blog = await getRecentPosts(SITE.featuredPostCount)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  <section class="grid grid-cols-1 gap-8 py-4 md:grid-cols-2 md:gap-12">
    <div class="flex flex-col gap-y-4">
      <h1 class="text-3xl font-semibold leading-tight">Classics, reopened.</h1>
      <p class="text-muted-foreground">
        Kapisce is an open-source reimagining of the literary canon — annotated,
        illustrated, and built for modern readers who want to actually finish the
        great books.
      </p>
      <p class="text-muted-foreground">
        Plain-text editions are free forever. Enhanced editions add annotations,
        scene illustrations, and reading tools for educators and book clubs.
      </p>
    </div>
    <div class="flex flex-col gap-y-6">
      <div>
        <p class="mb-1 text-sm font-medium">Open source, always.</p>
        <p class="text-muted-foreground text-sm">
          Source texts drawn from Project Gutenberg. The platform is
          MIT-licensed; content editions are CC BY-NC 4.0.
        </p>
      </div>
      <div>
        <p class="mb-1 text-sm font-medium">Two ways to read.</p>
        <p class="text-muted-foreground text-sm">
          Read at your own pace or use the built-in speed reader. Enhanced
          editions layer in callouts, footnotes, and AI-generated scene art on
          top of the original text.
        </p>
      </div>
      <div>
        <p class="mb-1 text-sm font-medium">Made for groups.</p>
        <p class="text-muted-foreground text-sm">
          Available in 20+ languages, with reading-club prompts baked into
          every enhanced edition.
        </p>
      </div>
    </div>
  </section>
  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">Latest posts</h2>
    <ul class="flex flex-col gap-y-4">
      {
        blog.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
    <div class="flex justify-center">
      <Link
        href="/novels"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        Browse novels <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>
</Layout>
