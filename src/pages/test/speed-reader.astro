---
import SpeedReaderComponent from '@/components/SpeedReader.svelte'

const sampleText = `
import Callout from '@/components/Callout.astro'
type CalloutVariant = 'note' | 'explanation'

<Callout title="Memorable Quote" variant="note">
alpha beta gamma delta, epsilon zeta eta theta. iota kappa lambda—mu nu xi: omicron pi rho; sigma! tau?
</Callout>

![Decorative illustration that should not enter the reader](/static/example.png)

upsilon
`
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Speed Reader Test</title>
  </head>
  <body>
    <main style="max-width: 960px; margin: 2rem auto; padding: 1rem;">
      <SpeedReaderComponent client:load text={sampleText} />
    </main>
  </body>
</html>
