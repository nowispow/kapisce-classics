---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects } from '@/lib/data-utils'

const projects = await getAllProjects()
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section>
    <div class="min-w-full">
      <div class="prose mb-8">
        <p class="mt-0">
          Kapisce is an ambitious reimagining of literary classics for modern
          readers. Instead of treating timeless works as distant or academic,
          Kapisce presents them as living stories that are easier to enter and more rewarding to finish.
        </p>
        <p>
          There are decades of stories, knowledge and experience to unearth in these works that have survived the rigorous test of time. 
          By combining the original texts with practical reading support, Kapisce helps everyday readers like you build confidence with
          classical literature you may have once found intimidating. By extension, when these classics are more accessible to you, 
          you as a reader can more easily form your own opinions about which of these works you resonate with.
        </p>
      </div>

      <h2 class="mb-4 text-2xl font-medium">Current Initiatives</h2>
      <div class="flex flex-col gap-4">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</Layout>
